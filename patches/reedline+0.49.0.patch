+    /// Query at most until the first failure. In terminals that do not answer
+    /// cursor-position reports, waiting two seconds at every prompt is worse
+    /// than giving up on the query for this editor session.
+    fn query_cursor_position(&mut self) -> Option<(u16, u16)> {
+        if self.cursor_position_unavailable {
+            return None;
+        }
+        match cursor::position() {
+            Ok(position) => Some(position),
+            Err(_) => {
+                self.cursor_position_unavailable = true;
+                None
+            }
+        }
+    }
+
+    /// Scroll once from a known cell so that the prompt starts on an empty
+    /// row without needing to know where an external command left the cursor.
+    fn anchor_at_bottom(&mut self) -> Result<()> {
+        let row = self.screen_height().saturating_sub(1);
+        self.stdout
+            .queue(MoveTo(0, row))?
+            .queue(Print("\r\n"))?
+            .flush()?;
+        self.prompt_start_row.mark_verified(row);
+        Ok(())
+    }
+
